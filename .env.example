# Copy to .env and fill in values before running docker-compose up
# NEVER commit .env to git

POSTGRES_USER=erp
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=erp_db

VALKEY_PASSWORD=change_me_in_prod

KC_ADMIN=admin
KC_ADMIN_PASSWORD=change_me_in_prod

RABBITMQ_USER=erp
RABBITMQ_PASSWORD=change_me_in_prod

GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_in_prod

# ── CORS (comma-separated allowed origins for the gateway) ───────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Zipkin endpoint (optional – comment out to disable tracing export) ───────
ZIPKIN_URL=http://zipkin:9411

# ── SeaweedFS filer URL ───────────────────────────────────────────────────────
SEAWEEDFS_FILER_URL=http://seaweed-filer:8888

# ── Ollama / LLM ─────────────────────────────────────────────────────────────
# URL de l'API Ollama (par défaut : conteneur interne)
OLLAMA_URL=http://ollama:11434
# Modèle à utiliser – exemples : mistral, llama3, gemma2
OLLAMA_MODEL=mistral
