{
  "uid": "erp-sales-funnel",
  "title": "ERP – Sales Funnel",
  "tags": ["erp", "sales"],
  "schemaVersion": 30,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP Requests / min – Sales Service",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus-ds" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"sales-service\"}[1m]) * 60",
          "legendFormat": "req/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP Requests / min – CRM Service",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus-ds" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"crm-service\"}[1m]) * 60",
          "legendFormat": "req/min"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency – Sales (ms)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus-ds" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 200 },
            { "color": "red", "value": 500 }
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"sales-service\"}[5m])) * 1000",
          "legendFormat": "p95 ms"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate – Sales (%)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "uid": "prometheus-ds" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * rate(http_server_requests_seconds_count{job=\"sales-service\",status=~\"5..\"}[5m]) / rate(http_server_requests_seconds_count{job=\"sales-service\"}[5m])",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Service (req/s)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "uid": "prometheus-ds" },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=~\"sales-service|crm-service|inventory-service\"}[2m])",
          "legendFormat": "{{job}} {{uri}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM Heap Used – All Services (MB)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",job=~\"sales-service|crm-service|inventory-service|identity-service\"} / 1048576",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI Service – Request Rate (req/s)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"ai-service\"}[2m])",
          "legendFormat": "{{handler}}"
        }
      ]
    }
  ]
}
